{
  "name": "@bizreflex/nestjs-kpax",
  "version": "0.1.0",
  "description": "NestJS module for the KPAX API v1: typed client, OAuth2 client credentials, and a database-backed registry of KPAX connections that can change at runtime.",
  "keywords": [
    "nestjs",
    "kpax",
    "mps",
    "managed-print-services",
    "printer",
    "fleet",
    "oauth2",
    "api-client"
  ],
  "author": "BizReflex LLC-FZ",
  "license": "MIT",
  "homepage": "https://github.com/Business-Reflection-Informatics-System/nestjs-kpax/tree/main/node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Business-Reflection-Informatics-System/nestjs-kpax.git",
    "directory": "node"
  },
  "bugs": {
    "url": "https://github.com/Business-Reflection-Informatics-System/nestjs-kpax/issues"
  },
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "docs",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "lint": "eslint \"{src,test,examples}/**/*.ts\"",
    "format": "prettier --write \"{src,test,examples}/**/*.ts\"",
    "generate:types": "node scripts/generate-types.js",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@nestjs/axios": ">=3.0.0",
    "@nestjs/common": ">=9.0.0",
    "axios": ">=1.4.0",
    "reflect-metadata": ">=0.1.13",
    "rxjs": ">=7.2.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.5.0",
    "@nestjs/axios": "^3.0.1",
    "@nestjs/common": "^9.4.3",
    "@nestjs/core": "^9.4.3",
    "@nestjs/platform-express": "^9.4.3",
    "@nestjs/testing": "^9.4.3",
    "@types/jest": "^29.5.11",
    "@types/node": "^18.19.3",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "axios": "^1.6.2",
    "better-sqlite3": "^11.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.5.0",
    "knex": "^2.5.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.1.0",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^5.0.10",
    "rxjs": "^7.8.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "test/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@bizreflex/nestjs-kpax$": "<rootDir>/src/index.ts"
    }
  }
}
